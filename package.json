{
  "name": "sg0hann-soundswap",
  "version": "1.5.0",
  "description": "Selective BuildTopia sound packs for Creative Destruction",
  "main": "app/main.cjs",
  "author": "sg0hann",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package:win": "electron-builder --win --x64 --dir --publish never",
    "prestart": "node tools/restore-data.cjs",
    "pretest": "node tools/restore-data.cjs",
    "prepackage:win": "node tools/restore-data.cjs",
    "installer:win": "electron-builder --win nsis --x64 --prepackaged release/win-unpacked --publish never"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samimustafaa/buildtopia-sound-app.git"
  },
  "productName": "BuilTopia Sound - sg0hann",
  "build": {
    "appId": "com.sg0hann.soundswap",
    "productName": "BuilTopia Sound - sg0hann",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "samimustafaa",
      "repo": "buildtopia-sound-app",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/assets/app.ico",
      "artifactName": "sg0hann-SoundSwap-${version}-Setup.exe",
      "executableName": "sg0hann SoundSwap"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BuilTopia Sound - sg0hann",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "files": [
      "app/**/*",
      "!app/data/original.parts/**/*",
      "!app/assets/audio/**/*",
      "!app/assets/weapon-placeholder-sheet.png",
      "!app/**/.*"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
